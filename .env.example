# Copy to .env and adjust, then:  set -a; source .env; set +a
#
# Postgres is published on 5433 by docker-compose.yml to avoid clashing with a
# local install on the default port.
DATABASE_URL=postgresql://rr_app:rr_password@localhost:5433/restaurant_reservations

# Connection pool bounds. POOL_MAX should exceed the number of worker threads.
POOL_MIN=1
POOL_MAX=10

# Seconds a caller waits for a free connection before PoolExhausted is raised.
# Callers past POOL_MAX queue here rather than failing immediately.
POOL_ACQUIRE_TIMEOUT=10

# Shows up in pg_stat_activity.application_name — makes it obvious which
# process is holding a connection when debugging pool exhaustion.
APP_NAME=rr-backend

# How many times book_reservation() retries after losing a race to a concurrent
# booking. See app/reservations.py for why this bounds concurrency, not latency.
BOOKING_MAX_ATTEMPTS=8

# Day 3.
REDIS_URL=redis://localhost:6379/0
MONGO_URL=mongodb://rr_app:rr_password@localhost:27017/restaurant_feedback?authSource=admin